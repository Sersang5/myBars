# Copia este archivo a .env.local y rellena los valores.
# Las claves solo se usan en el servidor: nunca con prefijo NEXT_PUBLIC_.

# Clave de Google Maps Platform (Places API (New)) - solo servidor
GOOGLE_MAPS_API_KEY=

# Clave de la API de Anthropic - solo servidor
ANTHROPIC_API_KEY=
# Modelo de Claude (opcional; por defecto claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5

# Único email autorizado a entrar (las altas están desactivadas en Supabase)
ALLOWED_EMAIL=

# Proyecto Supabase (URL y anon key; son públicas por diseño)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
